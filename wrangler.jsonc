{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cota-warehouse",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cota-warehouse",
      "database_id": "69372efb-bf9b-4619-9875-2e696ca71c08",
      "migrations_dir": "./migrations"
    }
  ],
  "routes": [{ "pattern": "cota.nexusautomation.cc", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
